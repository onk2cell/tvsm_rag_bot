# --- Gemini ---
GEMINI_API_KEY=your_gemini_key_here    # optional: an admin can also set this on /admin
FILE_SEARCH_STORE=            # filled in by index_document.py
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
MAX_TTS_CHARS=1500

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=pick_any_random_string
APP_SECRET=your_meta_app_secret        # for webhook signature verification (recommended)
GRAPH_VERSION=v21.0

# --- Client app / CRM webhook channel ---
CLIENT_WEBHOOK_USER=                   # Basic Auth username accepted by our webhook
CLIENT_WEBHOOK_PASSWORD=               # Basic Auth password accepted by our webhook
CLIENT_CRM_CUSTOMER_URL=               # client customer lookup endpoint
CLIENT_REPLY_WEBHOOK_URL=              # JAM send URL or callback URL for bot replies
CLIENT_API_USER=                       # Basic Auth for CRM lookup (when not stubbed)
CLIENT_API_PASSWORD=
CLIENT_REPLY_AUTH_MODE=basic           # basic | api_key (JAM WhatsApp send uses api_key)
CLIENT_REPLY_API_KEY=                  # required when CLIENT_REPLY_AUTH_MODE=api_key
CLIENT_STUB_CUSTOMER=false             # true = skip CRM lookup until client API is ready
CLIENT_HTTP_TIMEOUT_SEC=30
CLIENT_RETRY_WAIT_SEC=30
CLIENT_HISTORY_TTL_SEC=3600
CLIENT_DEDUP_TTL_SEC=604800
CLIENT_MAX_MEDIA_BYTES=10485760
CLIENT_QUEUE_NAME=default
CLIENT_TEST_MODE=false                 # never enable in production
CLIENT_ENV=production
CLIENT_VALIDATE_CONFIG=true
CLIENT_TEST_MEDIA_HOSTS=               # comma-separated; mock profile only

# --- Admin ---
ADMIN_TOKEN=                          # required for /admin/* API; sent as X-Admin-Token header
ADMIN_CONFIG_PATH=data/admin_config.json   # bot qualification config (auto-seeded on first run)
LEADS_CSV_PATH=data/leads.csv               # captured leads CSV export
INTERACTIONS_DB_PATH=data/interactions.db
LOAD_TEST_INTERACTIONS_DB_PATH=data/load_test_interactions.db
LOAD_TEST_TOKEN=                     # secret header value used only by load_test.py
INTERACTION_RETENTION_DAYS=90

# --- Redis / behaviour ---
REDIS_URL=redis://localhost:6379
MAX_HISTORY_TURNS=6
HISTORY_TTL_SEC=86400
RATE_LIMIT_PER_MIN=12
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_RECORD_SEC=60
