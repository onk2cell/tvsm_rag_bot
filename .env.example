# --- Gemini ---
GEMINI_API_KEY=your_gemini_key_here
FILE_SEARCH_STORE=            # filled in by index_document.py
GEMINI_MODEL=gemini-3.5-flash-lite
# Classifier tier; defaults to GEMINI_MODEL when unset.
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
MAX_TTS_CHARS=1500

# --- JAM CRM WhatsApp channel (production) ---
CLIENT_WEBHOOK_USER=                   # Basic Auth username accepted by our webhook
CLIENT_WEBHOOK_PASSWORD=               # Basic Auth password accepted by our webhook
CLIENT_CRM_CUSTOMER_URL=               # JAM: .../whatsapp_bot/customer
CLIENT_REPLY_WEBHOOK_URL=              # JAM send URL for bot replies
CLIENT_API_USER=                       # Basic Auth for CRM lookup (when not api_key)
CLIENT_API_PASSWORD=
CLIENT_REPLY_AUTH_MODE=api_key         # basic | api_key (JAM WhatsApp send + customer use api_key)
CLIENT_REPLY_API_KEY=                  # required when CLIENT_REPLY_AUTH_MODE=api_key
CLIENT_DISPOSE_URL=                    # JAM: .../whatsapp_bot/dispose (defaults from send URL)
CLIENT_STUB_CUSTOMER=false             # true = skip CRM lookup (local only)
CLIENT_HTTP_TIMEOUT_SEC=30
CLIENT_RETRY_WAIT_SEC=30
CLIENT_HISTORY_TTL_SEC=3600            # session idle expiry (1 hour)
CLIENT_DEDUP_TTL_SEC=604800
CLIENT_MAX_MEDIA_BYTES=10485760
CLIENT_QUEUE_NAME=client
CLIENT_TEST_MODE=false                 # never enable in production
CLIENT_ENV=production
CLIENT_VALIDATE_CONFIG=true
CLIENT_TEST_MEDIA_HOSTS=               # comma-separated; lab profile only
CLIENT_MEDIA_BASE_URL=https://aichatbot.jamoutsourcing.com/media

# --- Admin / leads / interactions ---
ADMIN_TOKEN=                          # bearer token for the admin panel (web.py); empty = panel disabled
ADMIN_CONFIG_PATH=data/admin_config.json
GEMINI_KEY_RUNTIME_PATH=data/gemini_key.txt   # where a key set on the admin page is stored
LEADS_CSV_PATH=data/leads.csv
INTERACTIONS_DB_PATH=data/interactions.db
LOAD_TEST_INTERACTIONS_DB_PATH=data/load_test_interactions.db
INTERACTION_RETENTION_DAYS=90

# --- Redis / behaviour ---
REDIS_URL=redis://localhost:6379
MAX_HISTORY_TURNS=40
HISTORY_TTL_SEC=86400
RATE_LIMIT_PER_MIN=12
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_RECORD_SEC=60
