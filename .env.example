# --- Gemini ---
GEMINI_API_KEY=your_gemini_key_here    # optional: an admin can also set this on /admin
FILE_SEARCH_STORE=            # filled in by index_document.py
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
MAX_TTS_CHARS=1500

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=pick_any_random_string
APP_SECRET=your_meta_app_secret        # for webhook signature verification (recommended)
GRAPH_VERSION=v21.0

# --- Admin ---
ADMIN_TOKEN=                          # required for /admin/* API; sent as X-Admin-Token header
ADMIN_CONFIG_PATH=data/admin_config.json   # bot qualification config (auto-seeded on first run)
LEADS_CSV_PATH=data/leads.csv               # captured leads CSV export
INTERACTIONS_DB_PATH=data/interactions.db
LOAD_TEST_INTERACTIONS_DB_PATH=data/load_test_interactions.db
LOAD_TEST_TOKEN=                     # secret header value used only by load_test.py
INTERACTION_RETENTION_DAYS=90

# --- Redis / behaviour ---
REDIS_URL=redis://localhost:6379
MAX_HISTORY_TURNS=6
HISTORY_TTL_SEC=86400
RATE_LIMIT_PER_MIN=12
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_RECORD_SEC=60
