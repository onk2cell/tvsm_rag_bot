{
	"info": {
		"name": "JAM WhatsApp Bot API - Dispose",
		"description": "Disposition update endpoint for the WhatsApp Bot API. Updates a lead's status (interested / not_interested / not_enquired / already_purchased_tvs_motor) by mobile number. Requires the X-API-KEY header. pincode is now a mandatory field for every status.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://tvsm.jamoutsourcing.com/index.php/whatsapp_bot",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "YOUR_API_KEY",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Dispose - Interested (full flow)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"mobile\": \"919999999999\",\n  \"pincode\": \"400001\",\n  \"status\": \"interested\",\n  \"dealer_code\": \"D12345\",\n  \"expected_purchased_date\": \"25/08/2026\",\n  \"product_name\": \"TVS King Deluxe\",\n  \"remark\": \"Customer wants to visit the showroom this weekend\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/dispose",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"dispose"
					]
				},
				"description": "Marks a lead as Interested. Requires dealer_code, expected_purchased_date (d/m/Y), and product_name in addition to the base fields (mobile, status, remark, pincode). Triggers lead stage calculation and, if the resulting stage is LEAD/HOT, a WhatsApp notification to the dealer."
			},
			"response": []
		},
